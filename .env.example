# 로컬 개발: cp .env.example .env.local 후 값 채우기 (.env.local 은 git 에 안 올라감)
# 모두 브라우저에 공개되는 값만. 비밀 키(secret)는 절대 여기 넣지 않는다 — BE 에만

# nicepay: 나이스페이 START 직접 연동 / portone: 포트원 경유 — BE 의 PAYMENT_PROVIDER 와 같게
VITE_PAYMENT_PROVIDER=nicepay

# 나이스페이 START — 가맹점관리자 TEST 상점의 클라이언트 키
VITE_NICEPAY_CLIENT_ID=

# 포트원 V2 — 콘솔 > 결제연동
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
